{
  "name": "@gander-labs/package-crafting-playground",
  "version": "0.3.5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gander-labs/package-crafting-playground.git"
  },
  "bin": {
    "package-crafting-playground": "dist/package-crafting-playground.js"
  },
  "files": [
    "dist/package-crafting-playground.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome lint .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:js && bun run build:bin",
    "build:js": "bun build ./index.ts --target node --banner '#!/usr/bin/env node' --outfile dist/package-crafting-playground.js",
    "build:bin": "bun run build:bin:bun && bun run build:bin:node && bun run build:bin:deno",
    "build:bin:bun": "bun build ./index.ts --compile --outfile dist/package-crafting-playground-bun",
    "build:bin:node": "node scripts/build-exe-node.mjs",
    "build:bin:deno": "deno compile --no-check --exclude-unused-npm --node-modules-dir=none --allow-net --allow-write --allow-env=GITHUB_TOKEN,GH_TOKEN --output dist/package-crafting-playground-deno ./index.ts",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=26"
  },
  "trustedDependencies": [
    "lefthook",
    "git-cliff"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@release-it/bumper": "^8.0.0",
    "@types/bun": "latest",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.12",
    "postject": "^1.0.0-alpha.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@optique/core": "^1.2.5",
    "@optique/run": "^1.2.5"
  }
}
